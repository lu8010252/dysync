# CI 多平台镜像:amd64 用 Debian bookworm(带 Intel 硬件加速驱动),arm64/armv7 用 Ubuntu focal(与原 Dockerfile-arm 一致)
ARG TARGETARCH
FROM mcr.microsoft.com/dotnet/aspnet:6.0 AS base-amd64
FROM mcr.microsoft.com/dotnet/aspnet:6.0-focal AS base-arm64
FROM mcr.microsoft.com/dotnet/aspnet:6.0-focal AS base-arm
FROM base-${TARGETARCH} AS final
ARG TARGETARCH
WORKDIR /app
EXPOSE 10101

RUN if [ "$TARGETARCH" = "amd64" ]; then \
      printf '%s\n' \
        "deb https://deb.debian.org/debian bookworm main contrib non-free non-free-firmware" \
        "deb https://security.debian.org/debian-security bookworm-security main contrib non-free non-free-firmware" \
        "deb https://deb.debian.org/debian bookworm-updates main contrib non-free non-free-firmware" \
        > /etc/apt/sources.list && \
      apt-get -o Acquire::Retries=5 update && \
      apt-get -o Acquire::Retries=5 install -y --no-install-recommends ffmpeg intel-media-va-driver-non-free mesa-va-drivers vainfo; \
    else \
      apt-get update && apt-get install -y --no-install-recommends ffmpeg; \
    fi && rm -rf /var/lib/apt/lists/*

RUN ffmpeg -version

COPY . .
ENV ASPNETCORE_URLS=http://*:10101
ENV TZ=Asia/Shanghai
ENTRYPOINT ["dotnet", "dy.net.dll"]
